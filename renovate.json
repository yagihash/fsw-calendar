{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yagihash/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Group @types/* updates together",
      "groupName": "@types packages",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "@types/**"
      ]
    },
    {
      "description": "Group Google Cloud / googleapis npm packages",
      "groupName": "Google Cloud packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "googleapis",
        "@google-cloud/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}
