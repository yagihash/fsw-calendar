{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yagihash/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automerge npm minor/patch updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group @types/* updates together",
      "groupName": "@types packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackagePrefixes": [
        "@types/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Group Google Cloud / googleapis npm packages",
      "groupName": "Google Cloud packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "googleapis",
        "@google-cloud/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update ghalint and actionlint versions in actions-check workflow",
      "fileMatch": [
        "^\\.github/workflows/actions-check\\.yml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+version=v?(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
